<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f7f2e9">
  <meta name="description" content="A wedding invitation">
  <title>Wedding Invitation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <audio id="weddingMusic" loop preload="none">
    <source src="assets/wedding-music.mp3" type="audio/mpeg">
  </audio>

  <button class="music-toggle" id="musicToggle" aria-label="Play background music" title="Play / pause music">
    <span class="music-icon">♫</span><span id="musicLabel">Play music</span>
  </button>

  <main>
    <section class="hero" id="home">
      <div class="hero-shade"></div>
      <div class="hero-content reveal">
        <p class="eyebrow">TOGETHER WITH THEIR FAMILIES</p>
        <p class="script-intro">joyfully invite you to celebrate</p>
        <h1><span data-bride>Bride Name</span><i>&</i><span data-groom>Groom Name</span></h1>
        <div class="gold-rule"><span>✦</span></div>
        <p class="hero-date" data-date-label> SATURDAY · 20 DECEMBER 2026 </p>
        <a class="text-link" href="#invitation">DISCOVER OUR INVITATION <span>↓</span></a>
      </div>
      <div class="hero-caption">A DAY TO REMEMBER · A LOVE TO CELEBRATE</div>
    </section>

    <section class="intro section-pad" id="invitation">
      <p class="eyebrow">A CELEBRATION OF LOVE</p>
      <h2>Two hearts.<br><em>One beautiful beginning.</em></h2>
      <p class="body-copy">With the blessing of our families, we would be delighted to have you with us as we begin our forever together.</p>
      <div class="names-line"><span data-bride>Bride Name</span><b>♥</b><span data-groom>Groom Name</span></div>
    </section>

    <section class="countdown-section section-pad">
      <p class="eyebrow">COUNTING DOWN TO FOREVER</p>
      <h2>Our special day</h2>
      <div class="countdown" aria-label="Countdown to the wedding">
        <div><strong id="days">00</strong><span>DAYS</span></div>
        <div><strong id="hours">00</strong><span>HOURS</span></div>
        <div><strong id="minutes">00</strong><span>MINUTES</span></div>
        <div><strong id="seconds">00</strong><span>SECONDS</span></div>
      </div>
      <p class="countdown-note" id="countdownNote">We cannot wait to celebrate with you.</p>
    </section>

    <section class="details section-pad" id="details">
      <p class="eyebrow">PLEASE JOIN US</p>
      <h2>The wedding celebration</h2>
      <div class="detail-grid">
        <article class="detail-card">
          <span class="detail-symbol">◇</span>
          <p class="eyebrow">WHEN</p>
          <h3 data-date-long>Saturday, 20 December 2026</h3>
          <p data-time>At 10:00 in the morning</p>
        </article>
        <article class="detail-card">
          <span class="detail-symbol">⌖</span>
          <p class="eyebrow">WHERE</p>
          <h3 data-venue>Wedding Venue Name</h3>
          <p data-address>Venue address, Sri Lanka</p>
          <a class="text-link dark-link" id="mapLink" href="https://maps.google.com/" target="_blank" rel="noopener">VIEW MAP ↗</a>
        </article>
      </div>
    </section>

    <section class="gallery section-pad">
      <p class="eyebrow">A FEW MOMENTS OF US</p>
      <h2>Our story in pictures</h2>
      <div class="gallery-grid">
        <img src="https://images.unsplash.com/photo-1537633552985-df8429e8048b?auto=format&fit=crop&w=1100&q=85" alt="Wedding couple embracing">
        <img src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1100&q=85" alt="Romantic wedding celebration">
        <img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1100&q=85" alt="Wedding details and flowers">
      </div>
    </section>

    <section class="rsvp section-pad" id="rsvp">
      <p class="eyebrow">KINDLY RESPOND</p>
      <h2>Will you join us?</h2>
      <p class="body-copy">Your presence would make our day even more special. Please let us know if you can celebrate with us.</p>
      <form id="rsvpForm" class="rsvp-form">
        <label for="guestName">Your name</label>
        <input id="guestName" name="name" autocomplete="name" placeholder="Enter your full name" required>
        <label for="attendance">Will you be attending?</label>
        <select id="attendance" name="attendance" required>
          <option value="">Please select</option>
          <option value="Joyfully accepts">Joyfully accepts</option>
          <option value="Regretfully declines">Regretfully declines</option>
        </select>
        <label for="guestCount">Number of guests</label>
        <select id="guestCount" name="guests">
          <option>1</option><option>2</option><option>3</option><option>4</option><option>5</option>
        </select>
        <button class="gold-button" type="submit">SEND RSVP</button>
        <p class="form-note">This starter version sends your response through WhatsApp.</p>
      </form>
    </section>

    <footer class="footer">
      <div class="gold-rule"><span>✦</span></div>
      <p class="script-intro">With love,</p>
      <h2><span data-bride>Bride Name</span> <i>&</i> <span data-groom>Groom Name</span></h2>
      <p class="eyebrow">WE LOOK FORWARD TO CELEBRATING WITH YOU</p>
      <p class="copyright">MADE WITH LOVE · <span data-year>2026</span></p>
    </footer>
  </main>

  <div class="envelope-screen" id="envelopeScreen">
    <div class="envelope-intro">
      <p class="eyebrow">YOU ARE CORDIALLY INVITED</p>
      <p class="envelope-small">A special invitation for you</p>
      <button class="envelope-button" id="openInvitation" aria-label="Open wedding invitation">
        <span class="envelope-back"></span>
        <span class="letter">
          <span class="letter-flourish">✦</span>
          <span class="letter-title">The Wedding</span>
          <span class="letter-subtitle">of</span>
          <span class="letter-names"><span data-bride>Bride Name</span><br>&amp;<br><span data-groom>Groom Name</span></span>
          <span class="letter-flourish">✦</span>
        </span>
        <span class="envelope-pocket"></span>
        <span class="envelope-flap"></span>
        <span class="wax-seal">♥</span>
      </button>
      <p class="open-hint">TAP TO OPEN</p>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
